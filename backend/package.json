{
  "name": "nl2build-backend",
  "version": "1.0.0",
  "description": "Backend service for NL2Build - Android app builder",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "echo 'No build step required'",
    "docker:build": "docker build -t nl2build-backend .",
    "docker:run": "docker run -p 3000:3000 nl2build-backend"
  },
  "keywords": [
    "android",
    "app-builder",
    "ai",
    "cicd"
  ],
